+class Dual(BaseModel):
+    a: float
+    b: float
+
+
+@vt.verified_schema(preflight_check=False)  # decoration must not raise; the bridge gate does
+def impossible(p: Dual):
+    vt.require(p.a >= 0.8)
+    vt.require(p.b >= 0.8)
+    vt.require(p.a + p.b == 1.0)
+
+
+def test_preflight_rejects_an_infeasible_contract_before_any_token():
+    from vexx.bridges.hf_transformers import InfeasibleContract
+
+    processor = VexxLogitsProcessor(FakeTokenizer(), spec=impossible)
+    with pytest.raises(InfeasibleContract) as error:
+        processor.preflight()
+    assert error.value.report.status == "UNSAT"
+
+    feasible = VexxLogitsProcessor(FakeTokenizer(), spec=linear)
+    report = feasible.preflight()
+    assert report.status in {"SAT", "UNKNOWN"}
+    assert feasible.tiers() == {
+        "mask": "exact",
+        "contract": "available",
+        "solver": "available",
+        "jumpback": "engine",
+    }
+    grammar_only = VexxLogitsProcessor(FakeTokenizer())
+    assert grammar_only.preflight() is None
+    assert grammar_only.tiers()["mask"] == "exact"
+    assert grammar_only.tiers()["contract"] == "unavailable"
+
+
