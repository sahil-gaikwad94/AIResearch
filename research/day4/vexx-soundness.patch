+    been paid for, and the mask has no legal continuation at the first field it touches.
+    """
+
+    def __init__(self, report: Any):
+        self.report = report
+        details = getattr(report, "details", None) or []
+        summary = "; ".join(str(d) for d in details[:3])
+        super().__init__(f"specification is infeasible: {summary or 'exact solver returned UNSAT'}")
+
+
 def _report_ok(report: Any) -> bool:
     if report is None:
         return True
@@ -102,6 +117,40 @@ class VexxLogitsProcessor:
 
         return verify_json(self.spec, text)
 
+    def preflight(self) -> Any:
+        """Tier-2 gate: run the exact rational preflight before decoding starts.
+
+        Returns the :class:`~vexx.compiler.vir.PreflightResult` for a decidable spec, ``None``
+        when no spec was supplied, and raises :class:`InfeasibleContract` when the exact solver
+        proves ``UNSAT``. ``UNKNOWN`` is *not* an error here: a spec the solver cannot decide is
+        still worth attempting, and the per-token tiers will reject whatever is provably bad.
+        """
+        if self.spec is None:
+            return None
+        from ..compiler.preflight import run_preflight
+
+        vir = getattr(self.spec, "spec", self.spec)
+        report = run_preflight(vir)
+        if getattr(report, "status", None) == "UNSAT":
+            raise InfeasibleContract(report)
+        return report
+
+    def tiers(self) -> dict[str, str]:
+        """What this processor actually wires, so "four-tier" is inspectable rather than claimed.
+
+        ``mask`` is tier 0 and always exact when a vocabulary is available. ``contract`` and
+        ``solver`` are available whenever a spec is attached (tier 1 interval contraction and
+        tier 2 exact feasibility, reached through :meth:`preflight` and the schema mask's domain
+        checks). ``jumpback`` lives in the decode engine, not in a logits processor: a dead-end
+        row is recorded and the orchestrator rewinds, which a HF ``LogitsProcessor`` cannot do.
+        """
+        return {
+            "mask": "exact" if self.masker is not None else "unavailable",
+            "contract": "available" if self.spec is not None else "unavailable",
+            "solver": "available" if self.spec is not None else "unavailable",
+            "jumpback": "engine",
+        }
